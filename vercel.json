{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/auth-config", "destination": "/api/auth?config=1" },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(curl|Wget|HTTPie|xh)/.*"
        }
      ],
      "destination": "/api/lastfm?view=card"
    },
    { "source": "/", "destination": "/home" },
    { "source": "/2.0", "destination": "/api/nyafm" },
    { "source": "/2.0/", "destination": "/api/nyafm" },
    { "source": "/1/:path*", "destination": "/api/nyafm" },
    { "source": "/term", "destination": "/api/nyafm" },
    { "source": "/term/:path*", "destination": "/api/nyafm" },
    { "source": "/fm/term", "destination": "/api/nyafm" },
    { "source": "/api/lyrics", "destination": "/api/nyafm" },
    { "source": "/v1", "destination": "/api/nyafm" },
    { "source": "/v1/:path*", "destination": "/api/nyafm" },
    { "source": "/apis/:path*", "destination": "/api/nyafm" },
    { "source": "/fm/api/:path*", "destination": "/api/nyafm" },
    { "source": "/fm/s", "destination": "/api/nyafm" },
    { "source": "/fm/s/:path*", "destination": "/api/nyafm" }
  ],
  "crons": [
    { "path": "/fm/api/spotify/sync", "schedule": "0 0 * * *" }
  ],
  "redirects": [
    {
      "source": "/blog/posts/:path*",
      "destination": "/blog",
      "permanent": false
    }
  ],
  "functions": {
    "api/nyafm.mjs": { "maxDuration": 30 },
    "api/motion-cover.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  },
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "referrer-policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
