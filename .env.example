# Copy this file to .env and fill in real values for local development
# (vercel dev will read .env automatically).
#
# On Vercel itself, set these under Project → Settings → Environment Variables
# instead of committing a .env file — that keeps the key out of GitHub entirely.

# Get a free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_USERNAME=ruytha
